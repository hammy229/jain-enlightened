# Jain Enlightened (Laravel) configuration template
# Copy this file to .env and fill in your own values. Never commit .env.
#   cp .env.example .env
#   php artisan key:generate

# === Application ===
APP_NAME="Jain Enlightened"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com
ASSET_URL=

# Optional alternate base URLs returned by /api (config/constant.php)
BASE_URL_STAGING=
BASE_URL_TESTING=

# === Logging ===
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error
LOG_SLACK_WEBHOOK_URL=
PAPERTRAIL_URL=
PAPERTRAIL_PORT=

# === Database ===
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jain_enlightened
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_SOCKET=
DB_ENCRYPT=
DB_TRUST_SERVER_CERTIFICATE=
DB_FOREIGN_KEYS=
MYSQL_ATTR_SSL_CA=
# Optional single-string connection URL (overrides the DB_* values above when set)
DATABASE_URL=

# === Cache, session, queue, broadcast, filesystem ===
BROADCAST_DRIVER=log
CACHE_DRIVER=file
CACHE_PREFIX=
FILESYSTEM_DRIVER=local
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_CONNECTION=
SESSION_STORE=
SANCTUM_STATEFUL_DOMAINS=localhost

# === Redis ===
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_URL=
REDIS_USERNAME=
REDIS_CLIENT=phpredis
REDIS_CLUSTER=redis
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=
REDIS_QUEUE=default

# === Memcached ===
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211
MEMCACHED_PERSISTENT_ID=
MEMCACHED_USERNAME=
MEMCACHED_PASSWORD=

# === Mail ===
MAIL_MAILER=smtp
MAIL_HOST=smtp.your-mail-provider.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_EHLO_DOMAIN=
MAIL_LOG_CHANNEL=
MAIL_FROM_ADDRESS=you@your-domain.com
MAIL_FROM_NAME="Jain Enlightened"
# Address that receives "new system user created" notifications
ADMIN_NOTIFY_EMAIL=admin@example.com
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net
POSTMARK_TOKEN=

# === Admin seeder (php artisan db:seed --class=AdminSeeder) ===
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me

# === AWS (S3 file storage, SES, DynamoDB cache, SQS queue) ===
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=your-bucket-name
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
DYNAMODB_CACHE_TABLE=cache
DYNAMODB_ENDPOINT=
SQS_PREFIX=
SQS_QUEUE=default
SQS_SUFFIX=

# === Pusher (realtime) ===
PUSHER_APP_ID=your-pusher-app-id
PUSHER_APP_KEY=your-pusher-app-key
PUSHER_APP_SECRET=your-pusher-app-secret
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
MIX_PUSHER_APP_KEY=your-pusher-app-key
MIX_PUSHER_APP_CLUSTER=mt1

# === Ably (optional) ===
ABLY_KEY=

# === PayPal ===
PAYPAL_MODE=sandbox
PAYPAL_BASE_URI=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MONTHLY_PLAN=your-paypal-monthly-plan-id
PAYPAL_YEARLY_PLAN=your-paypal-yearly-plan-id
# Legacy names that appeared in the original configuration. config/services.php does not read them.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=

# === Stripe ===
STRIPE_BASE_URI=https://api.stripe.com
STRIPE_KEY=your-stripe-publishable-key
STRIPE_SECRET=your-stripe-secret-key
STRIPE_MONTHLY_PLAN=
STRIPE_YEARLY_PLAN=
# Legacy names that appeared in the original configuration. config/services.php does not read them.
STRIPE_TEST_PK=
STRIPE_TEST_SK=

# === IP geolocation (optional, used by stevebauman/location) ===
LOCATION_TESTING=false
IP_API_TOKEN=
IPDATA_TOKEN=
IPINFO_TOKEN=
KLOUDEND_TOKEN=
MAXMIND_USER_ID=
MAXMIND_LICENSE_KEY=

# === Third-party chatbot widget (footer) ===
FASTBOTS_BOT_ID=
